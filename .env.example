# Modèle Ollama utilisé par défaut
ATOM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Modèle d'embedding pour la mémoire (recherche sémantique)
ATOM_EMBED_MODEL=nomic-embed-text
# Port de l'interface sur le réseau local
ATOM_PORT=8000
# "mock" pour tester l'interface sans modèle
ATOM_PROVIDER=ollama

# Fuseau horaire (rappels)
TZ=Europe/Paris

# --- Notifications (ntfy) ---
# Adresse de l'interface Atom vue depuis ton téléphone (clic sur une notification)
ATOM_PUBLIC_URL=http://192.168.1.28:8000
# Adresse du serveur ntfy vue depuis ton téléphone
NTFY_BASE_URL=http://192.168.1.28:8080
NTFY_PORT=8080
# Sujet auquel s'abonner dans l'appli ntfy (choisis un nom difficile à deviner)
ATOM_NTFY_TOPIC=atom-changez-moi
# iPhone uniquement : décommente pour recevoir les notifications instantanément
# NTFY_UPSTREAM_BASE_URL=https://ntfy.sh

# --- Telegram ---
# Jeton donné par @BotFather (laisser vide pour désactiver)
ATOM_TELEGRAM_TOKEN=
# Ton identifiant Telegram (le bot te le donne au premier message). Plusieurs : séparés par des virgules
ATOM_TELEGRAM_ALLOWED=

# --- Accès distant (Tailscale) ---
# Décommente pour lancer Tailscale avec le reste
# COMPOSE_PROFILES=tailscale
# Clé d'authentification (console Tailscale → Settings → Keys). Vide : lien de connexion dans les logs
TS_AUTHKEY=
TS_HOSTNAME=atom

# --- Recherche web (SearXNG) ---
# Mets ATOM_SEARXNG_URL= (vide) pour désactiver la recherche
SEARXNG_SECRET=change-moi-par-une-longue-phrase

# --- Performances ---
# Nombre de threads CPU pour le modèle (0 = automatique). Mets le nombre de cœurs du conteneur.
ATOM_NUM_THREADS=0

# --- Sauvegarde ---
# Heure de la sauvegarde quotidienne et nombre de copies gardées (dossier ./backups)
ATOM_BACKUP_TIME=03:30
ATOM_BACKUP_KEEP=7

# --- Bibliothèque : projets de code ---
# Dossier du serveur contenant tes projets (monté en lecture seule dans /projects)
ATOM_PROJECTS_HOST_DIR=./projects
# Jeton GitHub pour les dépôts privés : github.com/settings/tokens → Fine-grained, « Contents: Read »
ATOM_GITHUB_TOKEN=
# Pour commit / push depuis le mode Code : jeton « fine-grained » limité à tes dépôts,
# permission Contents: Read and write. Signature des commits :
ATOM_GIT_NAME=Atom
ATOM_GIT_EMAIL=atom@localhost

# --- Mode hybride : fournisseur principal (Groq, Mistral…) ---
# Clé créée sur console.mistral.ai → API Keys. Vide = mode hybride désactivé.
ATOM_REMOTE_API_KEY=
# mistral-small-latest (rapide, économe) · mistral-large-latest (le plus capable) · codestral-latest (code)
ATOM_REMOTE_MODEL=mistral-small-latest
# Nombre maximum de requêtes Mistral par jour (protège l'offre gratuite)
ATOM_REMOTE_DAILY_LIMIT=200

# --- Fournisseurs distants supplémentaires (relais automatique + atelier multi-IA) ---
# Liste séparée par des virgules ; connus : groq, cerebras, gemini, openrouter, github, mistral
# (adresse, modèle par défaut et famille déjà renseignés). Une clé par fournisseur :
# ATOM_PROVIDERS=cerebras,gemini
# ATOM_CEREBRAS_API_KEY=
# ATOM_GEMINI_API_KEY=
# Options par fournisseur : _MODEL, _URL, _LIMIT (requêtes/jour), _FAMILY, _STRENGTH (1 à 3),
# _PRIVATE (1 = peut recevoir souvenirs/documents si tu l'autorises ; 0 pour les offres
# gratuites qui réutilisent les données — par défaut 0 pour gemini et openrouter).
# ATOM_GEMINI_PRIVATE=0
# Force estimée du modèle local (1 par défaut ; 2 si tu passes à un modèle plus gros)
# ATOM_LOCAL_STRENGTH=1

# --- Sécurité ---
# Mot de passe initial (facultatif : sinon l'interface le demande au premier lancement)
ATOM_PASSWORD=
# 127.0.0.1 = Atom n'est plus joignable depuis le réseau local, seulement via Tailscale
ATOM_BIND=0.0.0.0
